NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/leukemia_db

# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PATIENT_JWT_EXPIRES_IN=2h
ADMIN_JWT_EXPIRES_IN=8h

# Optional but recommended in production: a separate secret used only to hash
# invitation / reset codes. If unset, JWT_SECRET is used.
INVITATION_CODE_PEPPER=

# Comma separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mock OTP used by the patient login flow until an SMS provider is wired in
MOCK_OTP=123456

BCRYPT_ROUNDS=12

# Login rate limiting (defaults shown)
RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
LOGIN_ACCOUNT_RATE_LIMIT_MAX=8

# First administrator (used only by `npm run create-admin`; set them in your
# terminal or a Render Shell, do not commit real values)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed script (development only; refuses to run when NODE_ENV=production)
SEED_DOCTOR_NAME=Dr. Ayesha Khan
SEED_DOCTOR_EMAIL=doctor@leukemia.test
SEED_DOCTOR_PASSWORD=change-this-demo-password
SEED_DOCTOR_PHONE=03001234567

# Used only by `npm test`. MUST be a throw-away database whose name contains
# "test": the tests wipe it. Never point this at your Atlas production database.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/leukemia_test
