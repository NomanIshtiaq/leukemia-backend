NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/leukemia_db

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PATIENT_JWT_EXPIRES_IN=2h

# Comma separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: when set, doctor registration requires this key in the request body
DOCTOR_REGISTRATION_KEY=

# Mock OTP used by the patient login flow until an SMS provider is wired in
MOCK_OTP=123456

BCRYPT_ROUNDS=12

# Seed script
SEED_DOCTOR_NAME=Dr. Ayesha Khan
SEED_DOCTOR_EMAIL=doctor@leukemia.test
SEED_DOCTOR_PASSWORD=Doctor@12345
SEED_DOCTOR_PHONE=03001234567
